{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["**/*.test-d.ts", "**/type-assert.ts", "vitest.shared.ts"],
  "ignoreDependencies": [
    "@btravstack/lefthook",
    "@btravstack/typedoc",
    "typedoc",
    "typedoc-plugin-markdown",
    "vite"
  ],
  "workspaces": {
    "docs": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "examples/di-hexagonal": {
      "entry": ["src/emit-guards.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/entity-billing-domain": {
      "entry": ["src/emit-guards.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@orpc/zod", "kysely", "uuidv7"]
    },
    "examples/order-amqp-worker": {
      "ignoreDependencies": ["@amqp-contract/contract", "zod"]
    },
    "examples/order-api": {
      "ignoreDependencies": [
        "@btravstack/entity",
        "@btravstack/oauth-client",
        "@btravstack/pothos",
        "@btravstack/prisma",
        "@orpc/tanstack-query",
        "@pothos/core",
        "@pothos/plugin-errors",
        "@pothos/plugin-relay",
        "@unthrown/pothos",
        "graphql",
        "@tanstack/query-core",
        "@prisma/orm-postgres",
        "@btravstack/graphql-server",
        "graphql-yoga",
        "@btravstack/mcp-server",
        "@modelcontextprotocol/sdk",
        "@btravstack/http-client",
        "@btravstack/storage"
      ]
    },
    "examples/order-infrastructure": {
      "ignore": ["prisma/migrations/**"]
    },
    "examples/order-temporal-worker": {
      "entry": ["src/__tests__/legacy-workflows.ts"],
      "ignoreDependencies": ["zod"]
    },
    "internal/consumer-check": {
      "ignore": ["src/consumer.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "publint"]
    },
    "packages/core": {
      "ignoreDependencies": ["@btravstack/testing"]
    },
    "packages/prisma": {
      "ignoreDependencies": ["@prisma/orm-postgres"]
    },
    "templates/http-app": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@btravstack/config",
        "@btravstack/contract",
        "@btravstack/di",
        "@btravstack/htmx-server",
        "@btravstack/http-server",
        "@orpc/client",
        "@orpc/json-schema",
        "@orpc/openapi",
        "@orpc/server",
        "@unthrown/orpc"
      ],
      "ignoreBinaries": ["tsc"]
    }
  }
}
