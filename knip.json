{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["**/*.test-d.ts", "**/type-assert.ts", "vitest.shared.ts"],
  "ignoreDependencies": [
    "@btravstack/lefthook",
    "@btravstack/oxlint",
    "@btravstack/typedoc",
    "typedoc",
    "typedoc-plugin-markdown"
  ],
  "workspaces": {
    "docs": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/core": {
      "ignoreDependencies": ["@btravstack/testing"]
    },
    "examples/di-hexagonal": {
      "entry": ["src/emit-guards.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/order-api": {
      "ignoreDependencies": [
        "@btravstack/entity",
        "@btravstack/prisma",
        "@orpc/tanstack-query",
        "@tanstack/query-core",
        "@prisma/adapter-pg",
        "zod"
      ]
    },
    "examples/order-temporal-worker": {
      "ignoreDependencies": ["zod"]
    }
  }
}
