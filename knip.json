{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["**/*.test-d.ts", "**/type-assert.ts", "vitest.shared.ts"],
  "ignoreDependencies": [
    "@btravstack/lefthook",
    "@btravstack/oxlint",
    "@btravstack/typedoc",
    "typedoc",
    "typedoc-plugin-markdown"
  ],
  "workspaces": {
    "docs": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/core": {
      "ignoreDependencies": ["@btravstack/testing"]
    },
    "examples/hexagonal-order-api": {
      "entry": ["src/emit-guards.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/order-api": {
      "ignoreDependencies": ["@btravstack/entity", "zod"]
    },
    "examples/order-temporal-worker": {
      "ignoreDependencies": ["zod"]
    }
  }
}
