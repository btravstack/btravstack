{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../docs/{tutorial,how-to,reference,explanation,examples}/**/*.md",
        "../../docs/index.md",
        "../../docs/scripts/extract-doc-samples.ts",
        "../../README.md",
        "../../packages/*/README.md"
      ],
      "outputs": ["src/generated/**"]
    },
    "@btravstack/example-order-infrastructure#generate": {
      "inputs": ["$TURBO_DEFAULT$", "src/prisma/contract.prisma", "prisma.config.ts"],
      "outputs": ["src/prisma/contract.json", "src/prisma/contract.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["build", "generate", "^generate"]
    },
    "@btravstack/core#typecheck": {
      "dependsOn": ["build", "@btravstack/testing#build"]
    },
    "@btravstack/internal-consumer-check#typecheck": {
      "cache": false,
      "dependsOn": [
        "@btravstack/amqp-worker#build",
        "@btravstack/cache#build",
        "@btravstack/config#build",
        "@btravstack/contract#build",
        "@btravstack/core#build",
        "@btravstack/di#build",
        "@btravstack/http-server#build",
        "@btravstack/mailer#build",
        "@btravstack/observability#build",
        "@btravstack/prisma#build",
        "@btravstack/storage#build",
        "@btravstack/temporal-worker#build",
        "@btravstack/testing#build"
      ]
    },
    "test": {
      "dependsOn": ["^build", "generate", "^generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "^generate", "@btravstack/internal-test-infra#dev:env"],
      "cache": false,
      "persistent": true
    },
    "dev:env": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@btravstack/docs#build": {
      "dependsOn": [
        "@btravstack/contract#build",
        "@btravstack/di#build",
        "@btravstack/config#build",
        "@btravstack/core#build",
        "@btravstack/testing#build",
        "@btravstack/observability#build",
        "@btravstack/cache#build",
        "@btravstack/mailer#build",
        "@btravstack/storage#build",
        "@btravstack/prisma#build",
        "@btravstack/http-server#build",
        "@btravstack/temporal-worker#build",
        "@btravstack/amqp-worker#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../packages/*/src/**",
        "../pnpm-workspace.yaml",
        "../README.md",
        "../packages/*/README.md",
        "../examples/**/README.md"
      ],
      "outputs": [".vitepress/dist/**", "api/*/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}
