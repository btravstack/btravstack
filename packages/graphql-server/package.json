{
  "name": "@btravstack/graphql-server",
  "version": "0.19.0",
  "description": "The GraphQL Yoga answerer for @btravstack/http-server",
  "keywords": [
    "graphql",
    "http",
    "server",
    "typescript"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/graphql-server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json && node ./node_modules/typescript-consumer/bin/tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@btravstack/contract": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/http-server": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-consumer": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@btravstack/contract": "workspace:^",
    "@btravstack/di": "workspace:^",
    "@btravstack/http-server": "workspace:^",
    "graphql": "^16.0.0 || ^17.0.0",
    "graphql-yoga": "^5.24.1",
    "unthrown": "^5.7.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
