{
  "name": "@btravstack/contract",
  "version": "0.50.0",
  "description": "The contract tier: markers and normed shapes a client and the server that implements it both need — the authenticated() marker, and a cursor page with its schema",
  "keywords": [
    "authentication",
    "contract",
    "openapi",
    "orpc",
    "pagination",
    "rpc",
    "typescript"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/contract"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./package.json": "./package.json",
    "./orpc": {
      "import": {
        "types": "./dist/orpc.d.mts",
        "default": "./dist/orpc.mjs"
      },
      "require": {
        "types": "./dist/orpc.d.cts",
        "default": "./dist/orpc.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/zod.ts src/orpc.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts src/zod.ts src/orpc.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json && node ./node_modules/typescript-consumer/bin/tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@btravstack/tsconfig": "catalog:",
    "@orpc/contract": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "temporal-polyfill": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-consumer": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@orpc/contract": "^2.0.0-beta.28",
    "zod": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "@orpc/contract": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
