{
  "name": "@btravstack/orpc",
  "version": "0.0.0",
  "description": "The oRPC starter for @btravstack/http: a router port in, the HttpHandler provider out",
  "keywords": [
    "hono",
    "http",
    "orpc",
    "starter",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/start#readme",
  "bugs": {
    "url": "https://github.com/btravstack/start/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/start.git",
    "directory": "packages/orpc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@btravstack/core": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/http": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@hono/node-server": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "hono": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@btravstack/core": "workspace:^",
    "@btravstack/di": "^0.1.0",
    "@btravstack/http": "workspace:^",
    "@hono/node-server": "^2.0.0",
    "@orpc/server": "^2.0.0-beta",
    "hono": "^4.0.0",
    "unthrown": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
