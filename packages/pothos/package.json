{
  "name": "@btravstack/pothos",
  "version": "0.44.1",
  "description": "Pothos fields that call oRPC procedures, each declared error answered as a typed GraphQL refusal",
  "keywords": [
    "graphql",
    "orpc",
    "pothos",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/pothos"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.mjs"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json && node ./node_modules/typescript-consumer/bin/tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@btravstack/tsconfig": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@pothos/core": "catalog:",
    "@pothos/plugin-errors": "catalog:",
    "@pothos/plugin-relay": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/pothos": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dataloader": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-consumer": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@orpc/client": "^2.0.0-beta.28",
    "@orpc/contract": "^2.0.0-beta.28",
    "@pothos/core": "^4.15.0",
    "@pothos/plugin-errors": "^4.9.0",
    "@pothos/plugin-relay": "^4.8.0",
    "@unthrown/pothos": "^0.1.2",
    "graphql": "^16.10.0 || ^17.0.0",
    "unthrown": "^5.12.1",
    "zod": "^4.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
