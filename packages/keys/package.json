{
  "name": "@btravstack/keys",
  "version": "0.46.0",
  "description": "An EnvelopeKeys port for @btravstack/core: per-owner root keys wrapped by an AWS KMS key of that owner, unwrapped in memory and cached for a TTL, erased with one key deletion, and an HKDF helper giving each purpose its own key",
  "keywords": [
    "crypto-shredding",
    "dependency-injection",
    "envelope-encryption",
    "hkdf",
    "kms",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/keys"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kms": {
      "import": {
        "types": "./dist/kms.d.mts",
        "default": "./dist/kms.mjs"
      },
      "require": {
        "types": "./dist/kms.d.cts",
        "default": "./dist/kms.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/kms.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts src/kms.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "catalog:",
    "@btravstack/config": "workspace:*",
    "@btravstack/core": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/internal-test-infra": "workspace:*",
    "@btravstack/testing": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3.1000.0",
    "@btravstack/config": "workspace:^",
    "@btravstack/core": "workspace:^",
    "@btravstack/di": "workspace:^",
    "unthrown": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
