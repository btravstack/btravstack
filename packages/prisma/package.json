{
  "name": "@btravstack/prisma",
  "version": "0.8.0",
  "description": "The Prisma starter for @btravstack/core: DATABASE_URL through Config, the Postgres driver adapter, and a client whose pool is the application scope's",
  "keywords": [
    "database",
    "dependency-injection",
    "postgres",
    "prisma",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/prisma"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.test-d.json --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@btravstack/config": "workspace:*",
    "@btravstack/core": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@btravstack/config": "workspace:^",
    "@btravstack/core": "workspace:^",
    "@btravstack/di": "workspace:^",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/instrumentation": "^7.0.0",
    "unthrown": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/instrumentation": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
