{
  "name": "@btravstack/temporal-testing",
  "version": "0.53.0",
  "description": "A Temporal server for the specs of @btravstack/temporal-worker and @btravstack/temporal-client consumers: one development server per Docker host, shared across processes, and a namespace per spec file",
  "keywords": [
    "temporal",
    "testcontainers",
    "testing",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/temporal-testing"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@btravstack/internal-test-infra": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "testcontainers": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "testcontainers": "^12.0.0",
    "vitest": ">=3.2.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
