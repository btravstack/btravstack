{
  "name": "@btravstack/observability",
  "version": "0.3.0",
  "description": "Observability for @btravstack/core: a strict Logger port correlated with the kernel's units, a dependency-free JSON sink, and the lifecycle events as log lines",
  "keywords": [
    "dependency-injection",
    "logger",
    "logging",
    "observability",
    "opentelemetry",
    "structured-logging",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/observability"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/pino.d.mts",
        "default": "./dist/pino.mjs"
      },
      "require": {
        "types": "./dist/pino.d.cts",
        "default": "./dist/pino.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.mts",
        "default": "./dist/otel.mjs"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/pino.ts src/otel.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts src/pino.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@btravstack/config": "workspace:*",
    "@btravstack/core": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/testing": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pino": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@btravstack/config": "workspace:^",
    "@btravstack/core": "workspace:^",
    "@btravstack/di": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "pino": "^10",
    "unthrown": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "pino": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
