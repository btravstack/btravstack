{
  "name": "@btravstack/http-server",
  "version": "0.23.0",
  "description": "The protocol-neutral Node HTTP runtime, request units, and authentication for @btravstack/core",
  "keywords": [
    "graceful-shutdown",
    "http",
    "lifecycle",
    "runtime",
    "starter",
    "typescript",
    "unthrown"
  ],
  "homepage": "https://github.com/btravstack/btravstack#readme",
  "bugs": {
    "url": "https://github.com/btravstack/btravstack/issues"
  },
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/btravstack/btravstack.git",
    "directory": "packages/http-server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./jwt": {
      "import": {
        "types": "./dist/jwt.d.mts",
        "default": "./dist/jwt.mjs"
      },
      "require": {
        "types": "./dist/jwt.d.cts",
        "default": "./dist/jwt.cjs"
      }
    },
    "./session": {
      "import": {
        "types": "./dist/session.d.mts",
        "default": "./dist/session.mjs"
      },
      "require": {
        "types": "./dist/session.d.cts",
        "default": "./dist/session.cjs"
      }
    },
    "./oidc": {
      "import": {
        "types": "./dist/oidc.d.mts",
        "default": "./dist/oidc.mjs"
      },
      "require": {
        "types": "./dist/oidc.d.cts",
        "default": "./dist/oidc.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/internal.ts src/jwt.ts src/oidc.ts src/session.ts --format cjs,esm --dts --clean",
    "dev": "tsdown src/index.ts src/internal.ts src/jwt.ts src/oidc.ts src/session.ts --format cjs,esm --dts --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test-d.json && node ./node_modules/typescript-consumer/bin/tsc --noEmit -p tsconfig.test-d.json"
  },
  "devDependencies": {
    "@btravstack/config": "workspace:*",
    "@btravstack/contract": "workspace:*",
    "@btravstack/core": "workspace:*",
    "@btravstack/di": "workspace:*",
    "@btravstack/internal-test-infra": "workspace:*",
    "@btravstack/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@unthrown/vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jose": "catalog:",
    "openid-client": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-consumer": "catalog:",
    "unthrown": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@btravstack/config": "workspace:^",
    "@btravstack/contract": "workspace:^",
    "@btravstack/core": "workspace:^",
    "@btravstack/di": "workspace:^",
    "jose": "^6",
    "openid-client": "^6",
    "unthrown": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    },
    "openid-client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
