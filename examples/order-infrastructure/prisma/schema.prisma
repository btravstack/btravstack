// The example's persistence schema. `orderId` is the business id the domain
// speaks, kept distinct from the surrogate primary key and carrying the UNIQUE
// constraint whose violation (P2002) the adapter translates into the domain's
// own `DuplicateOrder`. Generated into src/generated (gitignored) by the
// test/typecheck scripts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Order {
  id       Int    @id @default(autoincrement())
  orderId  String @unique
  quantity Int
}

// The customers vertical, on the same shape: `customerId` is the business id
// the domain speaks, kept distinct from the surrogate primary key.
model Customer {
  id         Int    @id @default(autoincrement())
  customerId String @unique
  name       String
}

// The transactional outbox: one row per fact worth broadcasting, written in
// the same transaction as the write it describes.
//
// The row IS the event envelope — `kind` (which sort of thing changed),
// `subjectId` (which one, and the key a reader compacts on), `occurredAt`, and
// `payload`. A NULL payload is the **tombstone**: the last word about a
// subject, saying it is gone. `id` is the sequence the relay publishes in, so
// a reader sees a subject's create before its tombstone. `publishedAt` is the
// relay's own bookkeeping — NULL means pending.
model OutboxMessage {
  id          Int       @id @default(autoincrement())
  kind        String
  subjectId   String
  payload     String?
  occurredAt  DateTime  @default(now())
  publishedAt DateTime?
}
