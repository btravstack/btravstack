{
  "name": "@btravstack/example-order-api",
  "private": true,
  "description": "The transport layer of the clean-architecture example: an oRPC router served over node:http by @btravstack/http",
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ../../docs/scripts/extract-doc-samples.ts --group order-api --out src/generated/doc-samples",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.test-d.json",
