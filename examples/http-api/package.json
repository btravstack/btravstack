{
  "name": "@btravstack/start-example-http-api",
  "private": true,
  "description": "A real node:http Runtime for @btravstack/start: DI-wired handlers, a unit per request, and Result mapped to a status at the edge",
  "license": "MIT",
  "author": "Benoit TRAVERS <benoit.travers.fr@gmail.com>",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
