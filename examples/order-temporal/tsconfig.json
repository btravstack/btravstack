{
  "extends": "@btravstack/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Inherited from the persistence layer this package composes: the generated
    // Prisma client imports its own files with explicit `.ts` extensions, and
    // those files are part of this program too. `noEmit` makes that legal.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.test-d.ts"]
}
